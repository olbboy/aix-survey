# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aix_survey?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email (for magic links)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="noreply@example.com"

# S3 / Object Storage (for evidence files)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="aix-survey-evidence"
S3_ENDPOINT="https://s3.amazonaws.com"  # Or compatible endpoint

# SSO (Optional)
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ISSUER=""

# App Config
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security
GUEST_DRAFT_TTL_DAYS="30"
MAX_FILE_SIZE_MB="100"
ALLOWED_FILE_TYPES="pdf,docx,xlsx,png,jpg,jpeg"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX="10"
RATE_LIMIT_LOGIN_WINDOW_MIN="15"
