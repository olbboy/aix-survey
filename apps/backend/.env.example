# Backend Environment Variables
# Copy this file to .env and update with your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aix_survey?schema=public"

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (for guest sessions and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage Configuration (for evidence files)
STORAGE_PROVIDER=local  # or 's3'
STORAGE_BUCKET=aix-survey-evidence
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (if using S3 storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=aix-survey-evidence

# Email Configuration (for results delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="AIX Survey <noreply@example.com>"

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info  # error, warn, info, debug, verbose
LOG_FORMAT=json  # json, simple

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_AUDIT_LOGS=true
ENABLE_FILE_UPLOAD=true

# Performance
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_TIMEOUT=300000  # 5 minutes in milliseconds
