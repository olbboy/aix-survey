// Prisma Schema for AI Maturity Assessment Platform
// Database: PostgreSQL 15+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

/// Multi-tenant organization
model Organization {
  id        String   @id @default(cuid())
  name      String
  industry  String?  // e.g., "finance", "healthcare", "retail"
  size      String?  // "small", "medium", "large", "enterprise"
  region    String?  // e.g., "VN", "SEA", "APAC"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users       User[]
  assessments Assessment[]
  progressGoals ProgressGoal[]
  assessmentHistory AssessmentHistory[]

  @@map("organizations")
}

/// User with RBAC (better-auth compatible)
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  Boolean   @default(false)
  name           String?
  image          String?

  // Custom fields
  role           Role      @default(RESPONDENT)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lastLoginAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  assessments Assessment[]
  auditLogs   AuditLog[]
  sessions    Session[]
  accounts    Account[]
  progressGoals ProgressGoal[]

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

enum Role {
  OWNER       // Full access to org
  ADMIN       // Manage templates, users, view all assessments
  REVIEWER    // Review and approve assessments
  RESPONDENT  // Fill assessments
  VIEWER      // Read-only access
}

/// better-auth Account (for OAuth providers)
model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  accountId         String   @map("account_id")
  providerId        String   @map("provider_id")
  accessToken       String?  @map("access_token") @db.Text
  refreshToken      String?  @map("refresh_token") @db.Text
  idToken           String?  @map("id_token") @db.Text
  expiresAt         DateTime? @map("expires_at")
  password          String?  // Hashed password for email/password auth

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// better-auth Session
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

/// better-auth Verification (for email verification and password reset)
model Verification {
  id         String   @id @default(cuid())
  identifier String   // email or user_id
  value      String   // verification code/token
  expiresAt  DateTime @map("expires_at")
  type       String   // "email" or "password_reset"

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier, type])
  @@index([identifier])
  @@map("verifications")
}

// ============================================================================
// ASSESSMENT TEMPLATE & STRUCTURE
// ============================================================================

/// Assessment template (versioned)
model AssessmentTemplate {
  id          String   @id @default(cuid())
  version     String   @unique // e.g., "v1.0", "v1.1"
  name        String
  nameEn      String?
  description String?  @db.Text
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  domains     Domain[]
  assessments Assessment[]

  @@map("assessment_templates")
}

/// Domain (5 domains: data, infra, tech, org, policy)
model Domain {
  id         String   @id @default(cuid())
  code       String   // "data", "infra", "tech", "org", "policy"
  name       String   // "Dữ liệu", "Hạ tầng", etc.
  nameEn     String?
  description String? @db.Text
  weight     Float    @default(1.0)
  sortOrder  Int      @default(0)

  templateId String
  template   AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  items      Item[]

  @@unique([templateId, code])
  @@index([templateId])
  @@map("domains")
}

/// Assessment item (37 items with level 1-5 descriptions)
model Item {
  id           String   @id @default(cuid())
  itemCode     String   // "1.1", "1.2", ..., "5.2"
  itemName     String   @db.Text
  itemNameEn   String?  @db.Text

  domainId     String
  domain       Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  // Maturity level descriptions (1-5)
  level1       String   @db.Text
  level2       String   @db.Text
  level3       String   @db.Text
  level4       String   @db.Text
  level5       String   @db.Text

  // Weighting
  weight       Float    @default(1.0)
  sortOrder    Int      @default(0)

  // Evidence requirements
  evidenceRequired      Boolean @default(false)
  evidenceRequiredIfLe  Int?    // Require evidence if score <= this value
  allowedFileTypes      String[] // ["pdf", "docx", "png", "url"]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  responses    Response[]

  @@unique([domainId, itemCode])
  @@index([domainId])
  @@map("items")
}

// ============================================================================
// ASSESSMENT & RESPONSES
// ============================================================================

/// Assessment instance (draft or finalized)
model Assessment {
  id             String   @id @default(cuid())

  // Session tracking
  sessionId      String?  @unique // For guest drafts (UUID in cookie)

  // Ownership
  userId         String?  // Null if guest
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Template
  templateId     String
  template       AssessmentTemplate @relation(fields: [templateId], references: [id])

  // Status
  status         AssessmentStatus @default(DRAFT)

  // Metadata (for filtering/benchmarking)
  industry       String?
  size           String?
  region         String?

  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  finalizedAt    DateTime?
  expiresAt      DateTime? // For guest drafts (30 days TTL)

  // Relations
  responses         Response[]
  evidences         Evidence[]
  snapshot          AssessmentSnapshot?
  auditLogs         AuditLog[]
  emailNotifications EmailNotification[]
  milestones        ProgressMilestone[]
  history           AssessmentHistory?
  organizationName  String?  // Denormalized for easier querying

  @@index([sessionId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@index([finalizedAt])
  @@map("assessments")
}

enum AssessmentStatus {
  DRAFT          // Guest or logged-in, not submitted
  IN_PROGRESS    // Being filled
  PENDING_REVIEW // Submitted, awaiting review
  FINALIZED      // Completed and locked
}

/// User response to an assessment item
model Response {
  id            String   @id @default(cuid())

  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  itemId        String
  item          Item     @relation(fields: [itemId], references: [id])

  // Answer
  score         Int?     // 1-5 (nullable: not yet answered)
  currentState  String?  @db.Text // User's description of current state

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  evidences     Evidence[]

  @@unique([assessmentId, itemId])
  @@index([assessmentId])
  @@map("responses")
}

/// Evidence file metadata
model Evidence {
  id           String   @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  responseId   String?
  response     Response? @relation(fields: [responseId], references: [id], onDelete: Cascade)

  // File info
  fileName     String
  fileType     String   // MIME type
  fileSize     Int      // Bytes
  storageUrl   String   // S3 URL or local path
  storageKey   String   // S3 key
  checksum     String   // SHA-256

  // Metadata
  description  String?  @db.Text // User-provided description
  uploadedBy   String?  // userId or "guest-{sessionId}"
  itemCode     String?  // Reference to which item this evidence is for

  // Security
  virusScanned Boolean  @default(false)
  scanResult   String?  // "clean", "infected", "error"

  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([assessmentId])
  @@index([responseId])
  @@index([uploadedBy])
  @@map("evidences")
}

// ============================================================================
// SCORING & RESULTS
// ============================================================================

/// Immutable snapshot for finalized assessments
model AssessmentSnapshot {
  id            String   @id @default(cuid())

  assessmentId  String   @unique
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Calculated scores
  itemScores    Json     // { "1.1": 3, "1.2": 4, ... }
  domainScores  Json     // { "data": 3.5, "infra": 4.0, ... }
  totalScore    Float    // Overall average
  maturityLevel String   // "Sơ khai", "Khởi đầu", etc.

  // Metadata
  templateVersion String
  numResponses    Int      // Total items answered
  completeness    Float    // Percentage of items answered

  // Full snapshot
  snapshotData  Json     // Complete assessment data for audit
  checksum      String   // SHA-256 of snapshotData

  createdAt     DateTime @default(now())

  @@index([assessmentId])
  @@map("assessment_snapshots")
}

// ============================================================================
// AUDIT & COMPLIANCE
// ============================================================================

/// Audit log (immutable, append-only)
model AuditLog {
  id            String   @id @default(cuid())

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  assessmentId  String?
  assessment    Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  // Action details
  action        String   // "CREATE", "UPDATE", "DELETE", "LOGIN", "EXPORT", "GUEST_LINKED", etc.
  entityType    String   // "Assessment", "Response", "User", etc.
  entityId      String?

  // Change tracking
  changes       Json?    // { before: {...}, after: {...} }

  // Request metadata
  ipAddress     String?
  userAgent     String?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([assessmentId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// BENCHMARK DATA
// ============================================================================

/// Anonymous benchmark data for industry comparison (Domain-level)
model BenchmarkData {
  id         String   @id @default(cuid())

  industry   String
  size       String
  region     String?

  domainCode String   // "data", "infra", etc.

  // Statistics
  avgScore   Float
  p25        Float    // 25th percentile
  p50        Float    // Median
  p75        Float    // 75th percentile
  p90        Float    // 90th percentile
  minScore   Float
  maxScore   Float
  stdDev     Float    // Standard deviation

  // Maturity level distribution
  maturityDistribution Json? // { "Sơ khai": 5, "Khởi đầu": 15, ... }

  sampleSize Int      // Number of assessments in this bucket

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([industry, size, domainCode])
  @@index([industry])
  @@index([domainCode])
  @@index([region])
  @@map("benchmark_data")
}

/// Item-level benchmark data for detailed comparison
model BenchmarkItemData {
  id         String   @id @default(cuid())

  industry   String
  size       String
  region     String?

  itemCode   String   // "1.1", "1.2", etc.

  // Statistics
  avgScore   Float
  p25        Float    // 25th percentile
  p50        Float    // Median
  p75        Float    // 75th percentile
  p90        Float    // 90th percentile
  minScore   Float
  maxScore   Float
  stdDev     Float    // Standard deviation

  // Score distribution
  scoreDistribution Json? // { "1": 10, "2": 20, "3": 30, "4": 25, "5": 15 }

  sampleSize Int      // Number of responses

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([industry, size, itemCode])
  @@index([industry])
  @@index([itemCode])
  @@index([region])
  @@map("benchmark_item_data")
}

/// Historical benchmark snapshots for trend analysis
model BenchmarkSnapshot {
  id            String   @id @default(cuid())

  snapshotDate  DateTime // Date of this snapshot (typically monthly/quarterly)

  industry      String
  size          String
  region        String?

  // Aggregate data
  domainScores  Json     // { "data": { avg: 3.2, p50: 3.5, ... }, ... }
  itemScores    Json     // { "1.1": { avg: 3.5, p50: 4.0, ... }, ... }
  overallScore  Float    // Average across all domains

  // Metadata
  sampleSize    Int      // Total assessments in snapshot
  templateVersion String // Template version used

  createdAt     DateTime @default(now())

  @@unique([industry, size, snapshotDate])
  @@index([industry])
  @@index([snapshotDate])
  @@index([region])
  @@map("benchmark_snapshots")
}

// ============================================================================
// EMAIL NOTIFICATIONS
// ============================================================================

/// Email notification tracking
model EmailNotification {
  id            String   @id @default(cuid())

  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Recipient
  recipientEmail String
  recipientName  String?

  // Email details
  subject       String
  templateName  String   // "assessment_results", "reminder", etc.

  // Status tracking
  status        EmailStatus @default(PENDING)
  sentAt        DateTime?
  deliveredAt   DateTime?
  openedAt      DateTime?
  clickedAt     DateTime?

  // Error handling
  attempts      Int      @default(0)
  lastError     String?  @db.Text

  // Metadata
  attachments   Json?    // List of attachment file keys
  templateData  Json?    // Data used for template rendering

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([assessmentId])
  @@index([recipientEmail])
  @@index([status])
  @@index([sentAt])
  @@map("email_notifications")
}

enum EmailStatus {
  PENDING    // Queued for sending
  SENDING    // Currently being sent
  SENT       // Successfully sent to SMTP server
  DELIVERED  // Confirmed delivered to recipient
  OPENED     // Recipient opened the email
  CLICKED    // Recipient clicked a link
  FAILED     // Failed to send
  BOUNCED    // Email bounced back
}

// ============================================================================
// PROGRESS TRACKING
// ============================================================================

/// Progress goals for organizations
model ProgressGoal {
  id              String   @id @default(cuid())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId          String?  // Who created the goal
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Goal definition
  goalType        GoalType
  targetScore     Float?   // Target overall score (for OVERALL_SCORE type)
  targetLevel     String?  // Target maturity level (for MATURITY_LEVEL type)
  domainCode      String?  // Specific domain (for DOMAIN_SCORE type)
  itemCode        String?  // Specific item (for ITEM_SCORE type)

  // Target details
  currentValue    Float?   // Starting value when goal created
  targetValue     Float    // Target value to achieve
  targetDate      DateTime // When to achieve by

  // Status tracking
  status          GoalStatus @default(ACTIVE)
  achievedAt      DateTime?
  achievedValue   Float?

  // Metadata
  title           String
  description     String?  @db.Text
  priority        GoalPriority @default(MEDIUM)

  // Milestones
  milestones      ProgressMilestone[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([targetDate])
  @@map("progress_goals")
}

enum GoalType {
  OVERALL_SCORE    // Improve overall assessment score
  MATURITY_LEVEL   // Reach specific maturity level
  DOMAIN_SCORE     // Improve specific domain score
  ITEM_SCORE       // Improve specific item score
  BENCHMARK_RANK   // Reach specific percentile ranking
}

enum GoalStatus {
  ACTIVE      // Currently tracking
  ACHIEVED    // Goal met
  MISSED      // Deadline passed without achievement
  CANCELLED   // User cancelled
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Milestones within goals
model ProgressMilestone {
  id              String   @id @default(cuid())

  goalId          String
  goal            ProgressGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // Milestone definition
  title           String
  description     String?  @db.Text
  targetValue     Float    // Intermediate target
  targetDate      DateTime

  // Status
  status          GoalStatus @default(ACTIVE)
  achievedAt      DateTime?
  achievedValue   Float?

  // Assessment that achieved this milestone
  assessmentId    String?
  assessment      Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([goalId])
  @@index([status])
  @@map("progress_milestones")
}

/// Assessment history metadata for progress tracking
model AssessmentHistory {
  id                String   @id @default(cuid())

  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assessmentId      String   @unique
  assessment        Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Snapshot of key metrics at finalization
  overallScore      Float
  maturityLevel     String
  domainScores      Json     // { "data": 3.5, "infra": 4.0, ... }

  // Change tracking (compared to previous assessment)
  previousAssessmentId String?
  previousAssessment   AssessmentHistory? @relation("AssessmentSequence", fields: [previousAssessmentId], references: [id], onDelete: SetNull)
  nextAssessments      AssessmentHistory[] @relation("AssessmentSequence")

  scoreChange       Float?   // Difference from previous
  levelChange       Int?     // Level improvement (-2 to +2)
  improvementRate   Float?   // Percentage improvement

  // Time metrics
  daysSincePrevious Int?     // Days between assessments
  assessmentNumber  Int      // Sequence number for this org (1, 2, 3, ...)

  createdAt         DateTime @default(now())

  @@index([organizationId])
  @@index([assessmentId])
  @@index([previousAssessmentId])
  @@map("assessment_history")
}
